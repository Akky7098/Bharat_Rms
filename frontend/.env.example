# Public frontend settings. Set before npm run build (or in the hosting build environment).
REACT_APP_BACKEND_URL=https://bharatspecialsteels.bharatspecialsteels.com
REACT_APP_AUTH_API_URL=https://bharatspecialsteels.bharatspecialsteels.com/api/auth
REACT_APP_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Optional module overrides; omit them to use REACT_APP_BACKEND_URL.
# REACT_APP_ATTENDANCE_BACKEND_URL=https://bharatspecialsteels.bharatspecialsteels.com
