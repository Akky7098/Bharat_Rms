# Today's additions: merge into the existing backend environment. Keep existing database,
# JWT, email, WhatsApp connection, port and Chromium settings unchanged.
GOOGLE_LOGIN_ENABLED=true
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
PAID_LEAVE_POLICY_START_DATE=2026-10-23
BACKEND_URL=https://bharatspecialsteels.bharatspecialsteels.com
FRONTEND_URL=https://dashboard.bharatspecialsteels.com
# Existing sales group is also used for attendance approval announcements.
SALES_WHATSAPP_GROUP_ID=YOUR_EXISTING_SALES_GROUP_ID@g.us

# Customer dispatch, delivery and scheduled payment reminders via existing Baileys session.
# Set false to pause this channel without changing emails.
DISPATCH_CUSTOMER_WHATSAPP_ENABLED=true
